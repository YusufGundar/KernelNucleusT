<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.knst.test">

    <!-- Vulkan backend requires API 24 (Android 7.0). -->
    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="34" />

    <!-- The app uses the GPU; make it required on the Play Store. -->
    <uses-feature
        android:glEsVersion="0x00030000"
        android:required="true" />

            <application
        android:hasCode="true"
        android:label="KernelNucleusT App">

                <activity
            android:name="com.knst.window.KnstActivity"
            android:exported="true"
            android:label="KernelNucleusT App"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|navigation"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize|stateHidden">

            <meta-data
                android:name="android.app.lib_name"
                android:value="knst_app" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

    </application>

</manifest>